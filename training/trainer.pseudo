# training/trainer.pseudo

# Trainer [the master manager that runs the learning process loop for the model].

class Trainer:
    
    # Initialize the trainer with the core components
    function initialize(model, dataset, optimizer, batch_size, epochs [number of complete training cycles]):
        self.model = model
        self.dataset = dataset
        self.optimizer = optimizer
        self.batch_size = batch_size
        self.epochs = epochs

    # Start the training loop
    function train():
        print("Starting training process...")
        
        for epoch from 1 to self.epochs:
            print("Beginning Epoch " + epoch)
            
            # Shuffle the order of data to prevent the model from memorizing order
            shuffled_indices = shuffle(get_range(self.dataset.size()))
            
            # Calculate total number of batches [small groups of items processed together]
            total_batches = calculate_total_batches(self.dataset.size(), self.batch_size)
            
            epoch_loss = 0.0
            
            for b from 0 to total_batches - 1:
                # Retrieve the batch inputs and targets
                inputs, targets = self.dataset.get_batch(self.batch_size, b)
                
                # Step 1: Forward Pass [running input data through the model to get predictions]
                # outputs logits of shape (batch_size, context_length, vocab_size)
                logits = self.model.forward(inputs)
                
                # Step 2: Compute Loss [measuring error score against correct target words]
                loss = calculate_cross_entropy_loss(logits, targets)
                epoch_loss = epoch_loss + loss
                
                # Step 3: Backward Pass / Backpropagation [calculating how much each weight needs to be changed to fix the error]
                # Generates a list of gradients, one for each parameter weight in the model
                gradients = self.model.backward(loss)
                
                # Step 4: Parameter update
                # The optimizer updates the weights of the model using the gradients
                self.optimizer.step(gradients)
                
                # Log progress every 10 batches
                if b % 10 == 0:
                    print("Epoch: " + epoch + " | Batch: " + b + "/" + total_batches + " | Current Loss: " + loss)
                    
            # Compute average loss for this epoch
            avg_epoch_loss = epoch_loss / total_batches
            print("Epoch " + epoch + " complete. Average Loss: " + avg_epoch_loss)
            
            # Save Checkpoint [saving the current model settings to a storage file so we don't lose progress]
            self.save_checkpoint(epoch, avg_epoch_loss)

    # Function to save model state to a file
    function save_checkpoint(epoch, loss):
        checkpoint_data = {
            "epoch": epoch,
            "loss": loss,
            "parameters": self.model.get_parameters() # Gets all current weights and biases
        }
        write_to_storage_file("model_checkpoint_epoch_" + epoch + ".bin", checkpoint_data)
        print("Saved checkpoint for epoch " + epoch)
